{
    "name":  "dsh-agent-manager",
    "version":  "0.1.1",
    "description":  "Stop and really remove subagents and Agent Teams teammates: retire their catalog/roster records in the parent session log (seq-preserving tombstones) and move their session directories to a recoverable trash. | 子代理/团队成员管理：停止运行实例、从子代理目录与团队花名册中真正移除，会话文件进可恢复回收站。",
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "subagent",
                     "agent-teams",
                     "cleanup"
                 ],
    "license":  "MIT",
    "type":  "module",
    "main":  "./lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./package.json":  "./package.json",
                    "./client":  "./lib/client.js"
                },
    "bin":  {
                "dsh-agent-manager":  "./lib/cli.js"
            },
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "README.md"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-slots"
                                          ],
                               "platform":  "web"
                           }
            },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "\u003e=4.0.0-rc \u003c5"
                         },
    "engines":  {
                    "node":  "^22.15.0 || \u003e=24.0.0"
                },
    "scripts":  {
                    "check":  "node --check lib/index.js \u0026\u0026 node --check lib/session-log.js \u0026\u0026 node --check lib/cli.js \u0026\u0026 node -e \"import(\u0027./lib/index.js\u0027)\"",
                    "selftest":  "node lib/selftest.js"
                }
}